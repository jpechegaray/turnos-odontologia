    "problema": "Consultorios odontológicos argentinos de 2-5 profesionales necesitan una agenda que garantice cero solapamientos por profesional y por sillón/box y que recupere los huecos que dejan las cancelaciones; hoy eligen entre soluciones locales jóvenes y fragmentadas o extranjeras sin adaptación a Argentina.",
    "usuarios": [
      "Odontólogo (eje del producto): ve su agenda, marca asistencia/ausencia, define horarios y bloqueos",
      "Recepción (uso mínimo y simple): da, reprograma y cancela turnos",
      "Administrador: configura prestaciones, sillones/boxes, profesionales, usuarios y plazos",
      "Paciente sin login: reserva online y se representa con un token de enlace único"
    ],
    "casos_de_uso": [
      "Crear turno sin solapamientos por profesional y sillón/box",
      "Reprogramar o cancelar un turno y liberar el horario",
      "Reserva online del paciente con token, sin cuenta",
      "Agenda diaria/semanal por profesional y por sillón; marcar asistencia",
      "Proponer pacientes de lista de espera al liberarse un hueco",
      "Recordatorio por email antes del turno"
    ],
    "funcionalidades_necesarias": [
      "Agenda por profesional y sillón/box con prevención de solapamientos",
      "Duración por prestación ajustable",
      "Horarios y bloqueos por profesional",
      "Crear/reprogramar/cancelar turnos",
      "Reserva online con token sin login",
      "Ficha básica de paciente",
      "Recordatorio por email (SMTP real)",
      "Roles odontólogo, recepción y administrador",
      "Diferenciador: lista de espera con propuesta de pacientes compatibles"
    ],
    "funcionalidades_opcionales": [
      "Odontograma, periodontograma e historia clínica",
      "WhatsApp",
      "Mercado Pago y señas",
      "Facturación ARCA",
      "Validación online de obras sociales",
      "Multisede, liquidaciones y reportes",
      "Campañas y recuperación de pacientes",
      "Asistentes con IA"
    ],
    "reglas_de_negocio": [
      "RN-01 Sin sobreturnos por profesional ni por sillón/box",
      "RN-02 Intervalos [inicio, fin): un turno que empieza cuando termina otro no se solapa",
      "RN-03 Duración por prestación, ajustable",
      "RN-04 No se dan turnos fuera del horario del profesional ni dentro de un bloqueo",
      "RN-05 Cancelar/reprogramar sin penalidad hasta 24 hs antes (configurable); fuera de plazo es tardía",
      "RN-06 Cancelar libera el horario y se ofrece a la lista de espera",
      "RN-07 El token solo da acceso a su propio turno",
      "RN-08 La reserva online solo toma horarios realmente libres"
    ],
    "integraciones": [
      "Email SMTP real (credenciales en .env, fuera del repo)"
    ],
    "restricciones": [
      "Proyecto académico, equipo de 6",
      "API con lógica de dominio y tests + front web simple",
      "Stack libre, lo define kb-creator",
      "Solo datos ficticios; sin secretos en el repo",
      "No crear cuentas ni contactar proveedores analizados"
    ],
    "riesgos": [
      "Evidencia de mercado mayormente comercial",
      "Token del paciente filtrable o adivinable",
      "Zona horaria y bordes de intervalos",
      "Concurrencia en reservas simultáneas",
      "Fallas silenciosas de email",
      "Datos de salud (Ley 25.326 y Ley 26.529)"
    ],
    "preguntas_abiertas": [
      "Validez del token y datos mínimos de la reserva online",
      "Anticipación del recordatorio",
      "Lista de espera: notificación automática o elección de la recepción",
